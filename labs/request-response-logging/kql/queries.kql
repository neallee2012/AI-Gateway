// =============================================================================
//  KQL Queries for AI Gateway Request/Response Logging (BasicV2 SKU)
// =============================================================================
//  Workspace: log-aigw-5e3hqtbguevmo  (id: 29f2f3ee-dbaa-4a26-af3f-2cdb2b1cad75)
//  App Insights: appi-aigw-5e3hqtbguevmo
// =============================================================================


// -----------------------------------------------------------------------------
//  ⭐ 1. 每筆請求的 Input / Output / Tokens (主要查詢)
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(1h)
| where Name startswith "POST /" and (Name has "chat/completions" or Name has "responses" or Name has "threads" or Name has "assistants")
| extend P = parse_json(tostring(Properties))
| extend RequestBody  = tostring(P["Request-Body"]),
         ResponseBody = tostring(P["Response-Body"]),
         Usage        = parse_json(tostring(P["Response-Body"])).usage
| project TimeGenerated,
          Endpoint      = Name,
          Backend       = Target,
          Status        = ResultCode,
          DurationMs,
          RequestBody,
          ResponseBody,
          PromptTokens     = toint(Usage.prompt_tokens),
          CompletionTokens = toint(Usage.completion_tokens),
          TotalTokens      = toint(Usage.total_tokens)
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  2. Custom Trace Policy Events (含 correlationId / clientIp / subscription)
// -----------------------------------------------------------------------------
AppTraces
| where TimeGenerated > ago(1h)
| where Message startswith "LLM "
| extend P = parse_json(tostring(Properties))
| project TimeGenerated,
          Message,
          CorrelationId  = tostring(P.correlationId),
          ApiId          = tostring(P.apiId),
          OperationId    = tostring(P.operationId),
          SubscriptionId = tostring(P.subscriptionId),
          ClientIp       = tostring(P.clientIp),
          StatusCode     = tostring(P.statusCode)
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  3. 以 correlationId 串起 Request + Response (端到端)
// -----------------------------------------------------------------------------
let corrId = "<paste-correlationId-here>";
AppTraces
| where Properties has corrId
| project TimeGenerated, Message, Properties


// -----------------------------------------------------------------------------
//  4. Token 使用量統計 (每小時)
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(24h)
| where Name has "chat/completions" and ResultCode == "200"
| extend Usage = parse_json(tostring(parse_json(tostring(Properties))["Response-Body"])).usage
| summarize Calls = count(),
            PromptTokens     = sum(toint(Usage.prompt_tokens)),
            CompletionTokens = sum(toint(Usage.completion_tokens)),
            TotalTokens      = sum(toint(Usage.total_tokens))
        by bin(TimeGenerated, 1h)
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  5. Streaming vs Non-Streaming
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(1h)
| where Name has "chat/completions"
| extend ReqBody = tostring(parse_json(tostring(Properties))["Request-Body"])
| extend IsStream = ReqBody has "\"stream\":true"
| summarize Count = count() by IsStream, ResultCode


// -----------------------------------------------------------------------------
//  6. 各客戶端 (Client IP) 使用量
// -----------------------------------------------------------------------------
AppTraces
| where TimeGenerated > ago(24h)
| where Message startswith "LLM Request"
| extend ClientIp = tostring(parse_json(tostring(Properties)).clientIp)
| summarize Requests = count() by ClientIp
| order by Requests desc


// -----------------------------------------------------------------------------
//  7. 錯誤分析 (4xx / 5xx)
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(1h)
| where toint(ResultCode) >= 400
| extend ResponseBody = tostring(parse_json(tostring(Properties))["Response-Body"])
| project TimeGenerated, Name, ResultCode, DurationMs, Target, ResponseBody
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  8. 前端請求總覽 (含 APIM 內部處理時間)
// -----------------------------------------------------------------------------
AppRequests
| where TimeGenerated > ago(1h)
| where Name startswith "POST /kunlenewfoundry01"
| project TimeGenerated, Name, Url, ResultCode, DurationMs, Success, ClientIP
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  ⭐ 9. Streaming 回應 → 把 SSE chunks 重組成完整可讀文字
// -----------------------------------------------------------------------------
//  說明：streaming 回應在 Response-Body 是大量 "data: {...}\n\n"，每塊有
//  delta.content 或 delta.reasoning_content。以下查詢把所有 delta 拼回完整字串。
//  注意：App Insights diagnostic 上限 256KB，超過會被截斷（IsTruncated=true）。
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(1h)
| where Name has "chat/completions" and ResultCode == "200"
| extend P    = parse_json(tostring(Properties))
| extend Resp = tostring(P["Response-Body"])
| where Resp startswith "data:"   // streaming only
| extend IsTruncated = strlen(Resp) >= 262000
| extend Lines = split(Resp, "data: ")
| mv-expand Line = Lines to typeof(string)
| where isnotempty(Line) and Line != "[DONE]\n\n"
| extend J = parse_json(trim_end("\n\n", trim(" ", Line)))
| where isnotnull(J.choices)
| extend OperationId = OperationId,
         Content        = tostring(J.choices[0].delta.content),
         Reasoning      = tostring(J.choices[0].delta.reasoning_content),
         FinishReason   = tostring(J.choices[0].finish_reason),
         Usage          = J.usage
| summarize FullContent   = strcat_array(make_list_if(Content, isnotempty(Content)), ""),
            FullReasoning = strcat_array(make_list_if(Reasoning, isnotempty(Reasoning)), ""),
            FinalUsage    = take_anyif(Usage, isnotnull(Usage)),
            FinishReason  = take_anyif(FinishReason, isnotempty(FinishReason)),
            IsTruncated   = any(IsTruncated),
            TimeGenerated = max(TimeGenerated)
        by OperationId
| project TimeGenerated, OperationId, IsTruncated, FinishReason,
          FullContent, FullReasoning,
          PromptTokens     = toint(FinalUsage.prompt_tokens),
          CompletionTokens = toint(FinalUsage.completion_tokens),
          TotalTokens      = toint(FinalUsage.total_tokens)
| order by TimeGenerated desc


// -----------------------------------------------------------------------------
//  10. 檢查截斷狀況：哪些回應達到 256KB 上限？
// -----------------------------------------------------------------------------
AppDependencies
| where TimeGenerated > ago(24h)
| where Name has "chat/completions"
| extend Resp = tostring(parse_json(tostring(Properties))["Response-Body"])
| extend BodySize = strlen(Resp), IsTruncated = strlen(Resp) >= 262000
| summarize Calls=count(), Truncated=countif(IsTruncated),
            AvgSize=avg(BodySize), MaxSize=max(BodySize)
        by ResultCode
| extend TruncatedPct = round(100.0 * Truncated / Calls, 1)
